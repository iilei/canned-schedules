{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Markdown AST",
 "type": "object",
 "required": [
  "blocks"
 ],
 "properties": {
  "blocks": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/block"
   }
  }
 },
 "additionalProperties": false,
 "$defs": {
  "inline": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "Text"
     ],
     "properties": {
      "Text": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "Strong"
     ],
     "properties": {
      "Strong": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/inline"
       }
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object"
    }
   ]
  },
  "heading": {
   "type": "object",
   "required": [
    "Heading"
   ],
   "properties": {
    "Heading": {
     "type": "object",
     "required": [
      "kind",
      "content"
     ],
     "properties": {
      "kind": {
       "type": "object",
       "required": [
        "Atx"
       ],
       "properties": {
        "Atx": {
         "type": "integer",
         "minimum": 1,
         "maximum": 6
        }
       },
       "additionalProperties": false
      },
      "content": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/inline"
       }
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "paragraph": {
   "type": "object",
   "required": [
    "Paragraph"
   ],
   "properties": {
    "Paragraph": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/inline"
     }
    }
   },
   "additionalProperties": false
  },
  "taskItem": {
   "type": "object",
   "required": [
    "task",
    "blocks"
   ],
   "properties": {
    "task": {
     "type": "string",
     "enum": [
      "Complete",
      "Incomplete"
     ]
    },
    "blocks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/block"
     }
    }
   },
   "additionalProperties": false
  },
  "list": {
   "type": "object",
   "required": [
    "List"
   ],
   "properties": {
    "List": {
     "type": "object",
     "required": [
      "kind",
      "items"
     ],
     "properties": {
      "kind": {
       "type": "object",
       "required": [
        "Bullet"
       ],
       "properties": {
        "Bullet": {
         "type": "string",
         "enum": [
          "Star",
          "Plus",
          "Minus"
         ]
        }
       },
       "additionalProperties": false
      },
      "items": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/taskItem"
       }
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "block": {
   "type": "object",
   "minProperties": 1,
   "maxProperties": 1,
   "properties": {
    "Heading": {
     "$ref": "#/$defs/heading/properties/Heading"
    },
    "Paragraph": {
     "$ref": "#/$defs/paragraph/properties/Paragraph"
    },
    "List": {
     "$ref": "#/$defs/list/properties/List"
    }
   },
   "additionalProperties": true
  }
 }
}