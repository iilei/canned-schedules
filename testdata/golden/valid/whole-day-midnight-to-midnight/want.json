        "THU"
      ],
      "state": "Off",
      "cron": {
        "posix": "0 0 * * 4",
        "aws": "0 0 ? * THU *"
      }
    }
  ],
  "occurrences": [
    {
      "dow": "WED",
      "time": "00:00",
      "state": "Medium",
      "cron": {
        "posix": "0 0 * * 3",
        "aws": "0 0 ? * WED *"
      }
    },
    {
      "dow": "THU",
      "time": "00:00",
      "state": "Off",
      "cron": {
        "posix": "0 0 * * 4",
