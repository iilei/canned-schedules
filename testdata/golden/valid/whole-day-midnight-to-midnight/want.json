{
  "schema-version": "2026-11-18",
  "name": "Schedule-Name",
  "annotations": {},
  "constraints": {
    "states": [
      "Off",
      "Minimum",
      "Medium",
      "Maximum"
    ],
    "sample-interval": 1,
    "require-base": false,
    "default-base": "Off",
    "alert-pattern": null
  },
  "base": "Off",
  "week": {
    "MON": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Off"
      }
    ],
    "TUE": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Off"
      }
    ],
    "WED": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Medium"
      }
    ],
    "THU": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Off"
      }
    ],
    "FRI": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Off"
      }
    ],
    "SAT": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Off"
      }
    ],
    "SUN": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Off"
      }
    ]
  },
  "transitions": [
    {
      "time": "00:00",
      "days": [
