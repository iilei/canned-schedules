{
  "schema-version": "2026-11-18",
  "name": "Schedule-Name",
  "annotations": {},
  "constraints": {
    "states": [
      "Off",
      "Minimum",
      "Medium",
      "Maximum"
    ],
    "sample-interval": 1,
    "require-base": false,
    "default-base": "Off",
    "alert-pattern": null
  },
  "base": "Minimum",
  "week": {
    "MON": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Minimum"
      }
    ],
    "TUE": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Minimum"
      }
    ],
    "WED": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Minimum"
      }
    ],
    "THU": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Minimum"
      }
    ],
    "FRI": [
      {
        "start": "00:00",
        "end": "00:00",
        "state": "Minimum"
      }
    ],
    "SAT": [
      {
        "start": "00:00",
        "end": "10:00",
        "state": "Minimum"
      },
      {
        "start": "10:00",
        "end": "00:00",
        "state": "Medium"
      }
    ],
    "SUN": [
      {
        "start": "00:00",
        "end": "10:00",
        "state": "Minimum"
      },
      {
        "start": "10:00",
        "end": "00:00",
        "state": "Medium"
      }
    ]
  },
  "transitions": [
    {
      "time": "00:00",
      "days": [
        "MON",
        "SUN"
      ],
      "state": "Minimum",
      "cron": {
        "posix": "0 0 * * 0-1",
        "aws": "0 0 ? * SUN-MON *"
      }
    },
    {
      "time": "10:00",
      "days": [
        "SAT",
        "SUN"
      ],
      "state": "Medium",
      "cron": {
        "posix": "0 10 * * 0,6",
        "aws": "0 10 ? * SUN,SAT *"
      }
    }
  ],
  "occurrences": [
    {
      "dow": "MON",
      "time": "00:00",
      "state": "Minimum",
      "cron": {
        "posix": "0 0 * * 1",
        "aws": "0 0 ? * MON *"
      }
    },
    {
      "dow": "SAT",
      "time": "10:00",
      "state": "Medium",
      "cron": {
        "posix": "0 10 * * 6",
        "aws": "0 10 ? * SAT *"
      }
    },
    {
      "dow": "SUN",
      "time": "00:00",
      "state": "Minimum",
      "cron": {
        "posix": "0 0 * * 0",
        "aws": "0 0 ? * SUN *"
      }
    },
    {
      "dow": "SUN",
      "time": "10:00",
      "state": "Medium",
      "cron": {
        "posix": "0 10 * * 0",
        "aws": "0 10 ? * SUN *"
      }
    }
  ],
  "warnings": []
}
