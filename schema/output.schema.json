{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iilei.github.io/canned-schedules/schema/2026-11-18/output.schema.json",
  "title": "canned-schedules canonical output",
  "type": "object",
  "required": [
    "schema-version",
    "name",
    "annotations",
    "constraints",
    "base",
    "week",
    "transitions",
    "warnings"
  ],
  "properties": {
    "schema-version": {
      "const": "2026-11-18"
    },
    "name": {
      "$ref": "#/$defs/text"
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "annotations": {
      "type": "object",
      "maxProperties": 40,
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9](?:-?[a-z0-9]){0,39}$": {
          "type": "string",
          "maxLength": 48
        }
      }
    },
    "constraints": {
      "description": "The rules the document was checked against: what the configuration and the flags allowed its author to write.",
      "type": "object",
      "required": [
        "states",
        "sample-interval",
        "require-base",
        "default-base",
        "alert-pattern"
      ],
      "properties": {
        "states": {
          "description": "The state ids a document may use, in configuration order.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state-id"
          }
        },
        "sample-interval": {
          "description": "Minutes. Every time in the schedule is a multiple of it. Consumers must accept every value listed here, even those the current CLI doesn't produce yet.",
          "type": "integer",
          "anyOf": [
            {
              "enum": [1, 2, 3, 4, 5, 6, 10, 12, 15, 20, 30]
            },
            {
              "multipleOf": 60,
              "minimum": 60,
              "maximum": 1440
            }
          ]
        },
        "require-base": {
          "description": "Whether the document must contain a BASE block.",
          "type": "boolean"
        },
        "default-base": {
          "description": "The state used when the document has no BASE block; null when the block is required.",
          "anyOf": [
            {
              "$ref": "#/$defs/state-id"
            },
            {
              "type": "null"
            }
          ]
        },
        "alert-pattern": {
          "description": "What every alert other than a schedule directive must match, in Go regular expression syntax and against the whole alert type; null when any alert is allowed.",
          "type": ["string", "null"]
        }
      }
    },
    "base": {
      "$ref": "#/$defs/state-id"
    },
    "week": {
      "description": "Per-day half-open runs covering 00:00-00:00; end 00:00 means the end of the day.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MON",
        "TUE",
        "WED",
        "THU",
        "FRI",
        "SAT",
        "SUN"
      ],
      "properties": {
        "MON": {
          "$ref": "#/$defs/day"
        },
        "TUE": {
          "$ref": "#/$defs/day"
        },
        "WED": {
          "$ref": "#/$defs/day"
        },
        "THU": {
          "$ref": "#/$defs/day"
        },
        "FRI": {
          "$ref": "#/$defs/day"
        },
        "SAT": {
          "$ref": "#/$defs/day"
        },
        "SUN": {
          "$ref": "#/$defs/day"
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "warnings": {
      "description": "Non-fatal diagnostics. No file names: the output depends only on the document and the flags.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[A-Za-z](?:[A-Za-z0-9 -]*[A-Za-z0-9])?$"
    },
    "state-id": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Za-z](?:-?[A-Za-z0-9])*$"
    },
    "weekday": {
      "enum": [
        "MON",
        "TUE",
        "WED",
        "THU",
        "FRI",
        "SAT",
        "SUN"
      ]
    },
    "hhmm": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
    },
    "day": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "run": {
      "type": "object",
      "required": [
        "start",
        "end",
        "state"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/hhmm"
        },
        "end": {
          "$ref": "#/$defs/hhmm"
        },
        "state": {
          "$ref": "#/$defs/state-id"
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "time",
        "days",
        "state",
        "cron"
      ],
      "properties": {
        "time": {
          "$ref": "#/$defs/hhmm"
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/weekday"
          }
        },
        "state": {
          "$ref": "#/$defs/state-id"
        },
        "cron": {
          "type": "object",
          "required": [
            "posix",
            "aws"
          ],
          "properties": {
            "posix": {
              "description": "Five-field Unix cron, numeric weekdays (0 = SUN).",
              "type": "string",
              "pattern": "^[0-5]?\\d (?:1?\\d|2[0-3]) \\* \\* (?:\\*|[0-6](?:-[0-6])?(?:,[0-6](?:-[0-6])?)*)$"
            },
            "aws": {
              "description": "Six-field EventBridge cron, weekday names.",
              "type": "string",
              "pattern": "^[0-5]?\\d (?:1?\\d|2[0-3]) \\? \\* (?:\\*|(?:SUN|MON|TUE|WED|THU|FRI|SAT)(?:-(?:SUN|MON|TUE|WED|THU|FRI|SAT))?(?:,(?:SUN|MON|TUE|WED|THU|FRI|SAT)(?:-(?:SUN|MON|TUE|WED|THU|FRI|SAT))?)*) \\*$"
            }
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "description": "Optional: the exact text to type instead (Markdown, backticks included).",
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "object",
          "required": [
            "text",
            "marker"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "marker": {
              "type": "string",
              "pattern": "^[ \\t]*\\^$"
            }
          }
        }
      },
      "dependentRequired": {
        "line": [
          "column"
        ],
        "column": [
          "line"
        ],
        "excerpt": [
          "line"
        ]
      }
    }
  }
}
