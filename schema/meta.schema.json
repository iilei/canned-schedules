{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iilei.github.io/canned-schedules/schema/2026-10-26/meta.schema.json",
  "title": "canned-schedules document META",
  "type": "object",
  "maxProperties": 41,
  "properties": {
    "schema-version": {
      "const": "2026-10-26",
      "description": "Optional. Defaults to the version built into the binary."
    }
  },
  "patternProperties": {
    "^x-[a-z0-9](?:-?[a-z0-9]){0,39}$": {
      "type": "string",
      "maxLength": 48
    }
  },
  "additionalProperties": false
}
