"""Schedule admonitions styled like the canned-schedules preflight page (made for the Furo theme).

Generated by canned-schedules {{ .version }}. Add to conf.py:

    import os, sys
    sys.path.append(os.path.abspath("_ext"))
    extensions += ["canned_schedules"]
"""

from pathlib import Path

from sphinx.util import logging

__version__ = "{{ .version }}"

_STATIC = Path(__file__).parent / "static"
_logger = logging.getLogger(__name__)


def _configure(app, config):
    # The stylesheet and its fonts live next to this file.
    config.html_static_path.append(str(_STATIC))

    # Schedule admonitions are written as ::: fences, which need MyST's colon_fence extension.
    extensions = config.myst_enable_extensions
    if "colon_fence" not in extensions:
        if isinstance(extensions, set):
            extensions.add("colon_fence")
        else:
            extensions.append("colon_fence")
        _logger.info("canned_schedules: enabled the MyST colon_fence extension for ::: admonitions")


def setup(app):
    app.setup_extension("myst_parser")
    app.connect("config-inited", _configure)
    app.add_css_file("canned-schedules.css")
    return {"version": __version__, "parallel_read_safe": True, "parallel_write_safe": True}
