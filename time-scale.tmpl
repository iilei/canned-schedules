{{- /* mise run render-time-scale --offset N; defaults to TIME_SCALE_OFFSET or 0 spaces.
0 restores left alignment. The named argument takes precedence over the environment.
PowerShell: $env:TIME_SCALE_OFFSET = '4'; mise exec -- gomplate -c .=schedule.json -f time-scale.tmpl
*/ -}}
{{- define "time-scale-padding" -}}
{{- $offsetText := "0" -}}
{{- if env.HasEnv "usage_offset" -}}
  {{- $offsetText = env.Getenv "usage_offset" -}}
{{- else if env.HasEnv "TIME_SCALE_OFFSET" -}}
  {{- $offsetText = env.Getenv "TIME_SCALE_OFFSET" -}}
{{- end -}}
{{- if not (regexp.Match "^[0-9]+$" $offsetText) -}}
  {{- test.Fail "offset (argument or TIME_SCALE_OFFSET) must be a non-negative integer" -}}
{{- end -}}
{{- strings.Repeat (conv.Atoi $offsetText) " " -}}
{{- end -}}
{{- $padding := tmpl.Exec "time-scale-padding" -}}
{{- $annotations := .time_scale_annotations -}}
{{- $next := 0 -}}
{{- range $slot, $marker := strings.Split "" .time_scale_ruler -}}
  {{- if ge $slot $next -}}
    {{- if or (eq $marker "║") (eq $marker "|") -}}
      {{- $label := index $annotations $slot -}}
      {{- printf "%s" $label -}}
      {{- $next = math.Add $slot (len $label) -}}
    {{- else -}}
      {{- printf " " -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- printf "%s\n%s%s\n" $padding $padding .time_scale_ruler -}}